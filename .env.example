# Copy this file to .env. Never share .env or commit actual credentials.
APP_PORT=8765
DATA_DIR=data

# Feishu enterprise self-built application; enable bot and read permissions.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: OpenAI-compatible /chat/completions endpoint.
# Blank key/model means free local message extraction; no AI API request.
# Explicitly select AI in the page to transmit selected messages to this provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
